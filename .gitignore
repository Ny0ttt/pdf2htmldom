# Conversion output (web UI uploads and CLI builds) -- may contain real documents
out/

# Fixtures are generated by fixtures/make_fixtures.py when the tests run
fixtures/*.pdf
fixtures/*.json

# Never commit real-world PDFs
fixtures/real/
*.pdf
!docs/**/*.pdf

